{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Beasts Simple Animation",
      "type": "process",
      "command": "javac",
      "args": [
        "-encoding",
        "UTF-8",
        "-d",
        "beasts_simple_animation/bin",
        "-sourcepath",
        "beasts_simple_animation/src",
        "beasts_simple_animation/src/echoesofluma/BattleDemo.java"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    }
  ]
}
